{
  "name": "zambiel-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:mobile-db": "tsx scripts/verify-mobile-database.ts",
    "mobile:start": "npm --prefix apps/zambiel-mobile start",
    "mobile:typecheck": "npm --prefix apps/zambiel-mobile run typecheck",
    "mobile:test": "npm --prefix apps/zambiel-mobile test",
    "mobile:export": "npm --prefix apps/zambiel-mobile run export",
    "stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,refund.created,refund.updated,refund.failed --forward-to localhost:3000/api/webhooks/stripe",
    "phase5:preflight": "tsx scripts/phase-5-preflight.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "catalog:import": "tsx scripts/import-products.ts",
    "catalog:stats": "tsx scripts/catalog-stats.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@tiptap/extension-image": "^3.31.2",
    "@tiptap/react": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "resend": "6.18.1",
    "sanitize-html": "^2.17.6",
    "stripe": "22.4.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "^2.16.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.25",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.5",
    "typescript": "6.0.3"
  }
}
