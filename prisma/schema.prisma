generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  OWNER
  STAFF
}

enum Locale {
  DE
  EN
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PromoType {
  FIXED
  PERCENT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum InventoryMovementType {
  OPENING_STOCK
  MANUAL_ADJUSTMENT
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_SOLD
  ORDER_RESTORED
}

enum PaymentMethod {
  STRIPE
  CASH_ON_DELIVERY
  PAY_AT_PICKUP
}

enum PaymentProvider {
  STRIPE
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum WebhookProcessingStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model SiteSettings {
  id                 Int      @id @default(1)
  displayName        String   @default("Zambiel") @db.VarChar(120)
  legalName          String?  @db.VarChar(160)
  slug               String   @unique(map: "SiteSettings_slug_key") @default("zambiel") @db.VarChar(120)
  email              String?  @db.VarChar(320)
  phone              String?  @db.VarChar(40)
  street             String?  @db.VarChar(200)
  postalCode         String?  @db.VarChar(16)
  city               String?  @db.VarChar(120)
  countryCode        String   @default("CH") @db.Char(2)
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  timezone           String   @default("Europe/Zurich") @db.VarChar(64)
  currency           String   @default("CHF") @db.Char(3)
  vatRegistered      Boolean?
  vatNumber          String?  @db.VarChar(64)
  primaryColor       String   @default("#153B35") @db.Char(7)
  secondaryColor     String   @default("#D6A84B") @db.Char(7)
  logoKey            String?  @db.VarChar(512)
  compactLogoKey     String?  @db.VarChar(512)
  faviconKey         String?  @db.VarChar(512)
  heroImageKey       String?  @db.VarChar(512)
  heroTitleDe        String?  @db.VarChar(240)
  heroTitleEn        String?  @db.VarChar(240)
  heroSubtitleDe     String?  @db.Text
  heroSubtitleEn     String?  @db.Text
  aboutDe            String?  @db.Text
  aboutEn            String?  @db.Text
  announcementDe     String?  @db.VarChar(500)
  announcementEn     String?  @db.VarChar(500)
  announcementActive Boolean  @default(false)
  instagramUrl       String?  @db.VarChar(512)
  facebookUrl        String?  @db.VarChar(512)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("sitesettings")
}

model FulfillmentSettings {
  id                   Int      @id @default(1)
  deliveryEnabled      Boolean  @default(true)
  pickupEnabled        Boolean  @default(true)
  pickupInstructionsDe String?  @db.Text
  pickupInstructionsEn String?  @db.Text
  reservationMinutes   Int      @default(30)
  lowStockDefault      Int      @default(5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("fulfillmentsettings")
}

model DeliveryZone {
  id                          String                   @id @default(cuid())
  nameDe                      String                   @db.VarChar(120)
  nameEn                      String                   @db.VarChar(120)
  active                      Boolean                  @default(true)
  feeRappen                   Int
  minimumSubtotalRappen       Int                      @default(0)
  freeDeliveryThresholdRappen Int?
  estimatedMinutes            Int
  sortOrder                   Int                      @default(0)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  postalCodes                 DeliveryZonePostalCode[]
  orders                      Order[]

  @@index([active, sortOrder], map: "DeliveryZone_active_sortOrder_idx")
  @@map("deliveryzone")
}

model DeliveryZonePostalCode {
  id             String       @id @default(cuid())
  deliveryZoneId String
  postalCode     String       @unique(map: "DeliveryZonePostalCode_postalCode_key") @db.VarChar(16)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade, map: "DeliveryZonePostalCode_deliveryZoneId_fkey")

  @@index([deliveryZoneId], map: "DeliveryZonePostalCode_deliveryZoneId_idx")
  @@map("deliveryzonepostalcode")
}

model Category {
  id               String     @id @default(cuid())
  slug             String     @unique(map: "Category_slug_key") @db.VarChar(160)
  nameDe           String     @db.VarChar(160)
  nameEn           String     @db.VarChar(160)
  descriptionDe    String?    @db.Text
  descriptionEn    String?    @db.Text
  parentId         String?
  imageKey         String?    @db.VarChar(512)
  seoTitleDe       String?    @db.VarChar(180)
  seoTitleEn       String?    @db.VarChar(180)
  seoDescriptionDe String?    @db.Text
  seoDescriptionEn String?    @db.Text
  active           Boolean    @default(true)
  sortOrder        Int        @default(0)
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  products         Product[]
  parent           Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, map: "Category_parentId_fkey")
  children         Category[] @relation("CategoryTree")

  @@index([deletedAt, active, sortOrder], map: "Category_deletedAt_active_sortOrder_idx")
  @@index([parentId, deletedAt, active, sortOrder], map: "Category_parentId_deletedAt_active_sortOrder_idx")
  @@map("category")
}

model Product {
  id               String           @id @default(cuid())
  categoryId       String
  slug             String           @unique(map: "Product_slug_key") @db.VarChar(180)
  nameDe           String           @db.VarChar(180)
  nameEn           String           @db.VarChar(180)
  descriptionDe    String?          @db.Text
  descriptionEn    String?          @db.Text
  imageKey         String?          @db.VarChar(512)
  status           ProductStatus    @default(DRAFT)
  featured         Boolean          @default(false)
  seoTitleDe       String?          @db.VarChar(180)
  seoTitleEn       String?          @db.VarChar(180)
  seoDescriptionDe String?          @db.Text
  seoDescriptionEn String?          @db.Text
  sourceHandle     String?          @unique(map: "Product_sourceHandle_key") @db.VarChar(180)
  sourceImportHash String?          @db.Char(64)
  sourceMetadata   Json?
  publishedAt      DateTime?
  active           Boolean          @default(true)
  available        Boolean          @default(true)
  sortOrder        Int              @default(0)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "Product_categoryId_fkey")
  variants         ProductVariant[]
  orderItems       OrderItem[]
  productOptions   ProductOption[]
  media            ProductMedia[]
  tags             ProductTag[]

  @@index([categoryId, deletedAt, active, sortOrder], map: "Product_categoryId_deletedAt_active_sortOrder_idx")
  @@index([deletedAt, available], map: "Product_deletedAt_available_idx")
  @@index([status, featured, publishedAt], map: "Product_status_featured_publishedAt_idx")
  @@map("product")
}

model ProductVariant {
  id                   String                      @id @default(cuid())
  productId            String
  nameDe               String                      @db.VarChar(160)
  nameEn               String                      @db.VarChar(160)
  sku                  String?                     @unique(map: "ProductVariant_sku_key") @db.VarChar(100)
  priceRappen          Int
  compareAtPriceRappen Int?
  barcode              String?                     @db.VarChar(120)
  weightGrams          Int?
  stockOnHand          Int                         @default(0)
  stockReserved        Int                         @default(0)
  lowStockThreshold    Int?
  trackInventory       Boolean                     @default(true)
  active               Boolean                     @default(true)
  sortOrder            Int                         @default(0)
  deletedAt            DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  product              Product                     @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductVariant_productId_fkey")
  orderItems           OrderItem[]
  optionValues         ProductVariantOptionValue[]
  media                ProductMedia[]
  inventoryMovements   InventoryMovement[]

  @@index([productId, deletedAt, active, sortOrder], map: "ProductVariant_productId_deletedAt_active_sortOrder_idx")
  @@index([trackInventory, stockOnHand, stockReserved], map: "ProductVariant_inventory_idx")
  @@map("productvariant")
}

model ProductTag {
  id       String    @id @default(cuid())
  name     String    @db.VarChar(120)
  slug     String    @unique(map: "ProductTag_slug_key") @db.VarChar(140)
  products Product[]

  @@map("producttag")
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  name      String               @db.VarChar(120)
  sortOrder Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductOption_productId_fkey")
  values    ProductOptionValue[]

  @@unique([productId, name], map: "ProductOption_productId_name_key")
  @@index([productId, sortOrder], map: "ProductOption_productId_sortOrder_idx")
  @@map("productoption")
}

model ProductOptionValue {
  id        String                      @id @default(cuid())
  optionId  String
  value     String                      @db.VarChar(160)
  sortOrder Int                         @default(0)
  option    ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade, map: "ProductOptionValue_optionId_fkey")
  variants  ProductVariantOptionValue[]

  @@unique([optionId, value], map: "ProductOptionValue_optionId_value_key")
  @@index([optionId, sortOrder], map: "ProductOptionValue_optionId_sortOrder_idx")
  @@map("productoptionvalue")
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "ProductVariantOptionValue_variantId_fkey")
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade, map: "ProductVariantOptionValue_optionValueId_fkey")

  @@id([variantId, optionValueId])
  @@index([optionValueId], map: "ProductVariantOptionValue_optionValueId_idx")
  @@map("productvariantoptionvalue")
}

model ProductMedia {
  id          String          @id @default(cuid())
  productId   String
  variantId   String?
  objectKey   String          @db.VarChar(2048)
  sourceUrl   String?         @db.VarChar(2048)
  contentHash String?         @db.Char(64)
  altDe       String?         @db.VarChar(240)
  altEn       String?         @db.VarChar(240)
  sortOrder   Int             @default(0)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductMedia_productId_fkey")
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, map: "ProductMedia_variantId_fkey")

  @@index([productId, sortOrder], map: "ProductMedia_productId_sortOrder_idx")
  @@index([variantId], map: "ProductMedia_variantId_idx")
  @@index([contentHash], map: "ProductMedia_contentHash_idx")
  @@map("productmedia")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique(map: "User_email_key") @db.VarChar(320)
  passwordHash        String?              @db.VarChar(255)
  name                String?              @db.VarChar(160)
  phone               String?              @db.VarChar(40)
  image               String?              @db.VarChar(512)
  emailVerified       DateTime?
  role                UserRole             @default(CUSTOMER)
  active              Boolean              @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     StaffInvitation[]    @relation("InvitedBy")
  address             CustomerAddress?
  inventoryMovements  InventoryMovement[]
  deviceSessions      StaffDeviceSession[]
  orders              Order[]
  promoRedemptions    PromoRedemption[]
  orderStatusEvents   OrderStatusEvent[]
  refundsRequested    Refund[]
  auditLogs           AuditLog[]

  @@index([role, active], map: "User_role_active_idx")
  @@map("user")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  @db.VarChar(64)
  provider          String  @db.VarChar(120)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(64)
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.VarChar(255)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId], map: "Account_userId_idx")
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique(map: "Session_sessionToken_key") @db.VarChar(255)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_idx")
  @@index([expires], map: "Session_expires_idx")
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique(map: "PasswordResetToken_tokenHash_key") @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordResetToken_userId_fkey")

  @@index([userId, expiresAt], map: "PasswordResetToken_userId_expiresAt_idx")
  @@map("passwordresettoken")
}

model StaffInvitation {
  id              String    @id @default(cuid())
  email           String    @db.VarChar(320)
  tokenHash       String    @unique(map: "StaffInvitation_tokenHash_key") @db.Char(64)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invitedBy       User?     @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull, map: "StaffInvitation_invitedByUserId_fkey")

  @@index([email, acceptedAt], map: "StaffInvitation_email_acceptedAt_idx")
  @@index([invitedByUserId], map: "StaffInvitation_invitedByUserId_idx")
  @@map("staffinvitation")
}

model CustomerAddress {
  id            String   @id @default(cuid())
  userId        String   @unique(map: "CustomerAddress_userId_key")
  label         String   @db.VarChar(80)
  recipientName String   @db.VarChar(160)
  phone         String   @db.VarChar(40)
  street        String   @db.VarChar(200)
  streetExtra   String?  @db.VarChar(200)
  postalCode    String   @db.VarChar(16)
  city          String   @db.VarChar(120)
  countryCode   String   @default("CH") @db.Char(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CustomerAddress_userId_fkey")

  @@map("customeraddress")
}

model StaffDeviceSession {
  id               String    @id @default(cuid())
  userId           String
  deviceName       String    @db.VarChar(160)
  platform         String    @default("android") @db.VarChar(40)
  refreshTokenHash String    @unique(map: "StaffDeviceSession_refreshTokenHash_key") @db.Char(64)
  pushToken        String?   @unique(map: "StaffDeviceSession_pushToken_key") @db.VarChar(512)
  expiresAt        DateTime
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "StaffDeviceSession_userId_fkey")

  @@index([userId, revokedAt, expiresAt], map: "StaffDeviceSession_userId_revokedAt_expiresAt_idx")
  @@map("staffdevicesession")
}

model PromoCode {
  id                    String            @id @default(cuid())
  code                  String            @unique(map: "PromoCode_code_key") @db.VarChar(64)
  type                  PromoType
  value                 Int
  minimumSubtotalRappen Int               @default(0)
  startsAt              DateTime?
  endsAt                DateTime?
  totalUsageLimit       Int?
  perCustomerLimit      Int?
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  redemptions           PromoRedemption[]
  orders                Order[]

  @@index([active, startsAt, endsAt], map: "PromoCode_active_startsAt_endsAt_idx")
  @@map("promocode")
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  orderId        BigInt    @unique(map: "PromoRedemption_orderId_key")
  userId         String?
  customerEmail  String    @db.VarChar(320)
  discountRappen Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict, map: "PromoRedemption_promoCodeId_fkey")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "PromoRedemption_orderId_fkey")
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull, map: "PromoRedemption_userId_fkey")

  @@index([promoCodeId, createdAt], map: "PromoRedemption_promoCodeId_createdAt_idx")
  @@index([promoCodeId, customerEmail], map: "PromoRedemption_promoCodeId_customerEmail_idx")
  @@index([userId], map: "PromoRedemption_userId_idx")
  @@map("promoredemption")
}

model Order {
  id                         BigInt                 @id @default(autoincrement())
  checkoutKeyHash            String                 @unique(map: "Order_checkoutKeyHash_key") @db.Char(64)
  userId                     String?
  guestTrackingTokenHash     String?                @unique(map: "Order_guestTrackingTokenHash_key") @db.Char(64)
  locale                     Locale                 @default(DE)
  customerName               String                 @db.VarChar(160)
  customerEmail              String                 @db.VarChar(320)
  customerPhone              String                 @db.VarChar(40)
  fulfillmentType            FulfillmentType
  status                     OrderStatus            @default(PAYMENT_PENDING)
  paymentMethod              PaymentMethod
  note                       String?                @db.Text
  subtotalRappen             Int
  discountRappen             Int                    @default(0)
  deliveryFeeRappen          Int                    @default(0)
  taxRateBps                 Int?
  taxAmountRappen            Int                    @default(0)
  totalRappen                Int
  promoCodeId                String?
  deliveryZoneId             String?
  deliveryZoneNameDeSnapshot String?                @db.VarChar(120)
  deliveryZoneNameEnSnapshot String?                @db.VarChar(120)
  version                    Int                    @default(0)
  completedAt                DateTime?
  cancelledAt                DateTime?
  cancellationReason         String?                @db.VarChar(500)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  user                       User?                  @relation(fields: [userId], references: [id], onDelete: SetNull, map: "Order_userId_fkey")
  promoCode                  PromoCode?             @relation(fields: [promoCodeId], references: [id], onDelete: SetNull, map: "Order_promoCodeId_fkey")
  deliveryZone               DeliveryZone?          @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, map: "Order_deliveryZoneId_fkey")
  address                    OrderAddress?
  items                      OrderItem[]
  statusEvents               OrderStatusEvent[]
  payment                    Payment?
  promoRedemption            PromoRedemption?
  notifications              NotificationDelivery[]
  inventoryMovements         InventoryMovement[]

  @@index([userId, createdAt], map: "Order_userId_createdAt_idx")
  @@index([status, createdAt], map: "Order_status_createdAt_idx")
  @@index([paymentMethod, status], map: "Order_paymentMethod_status_idx")
  @@index([promoCodeId], map: "Order_promoCodeId_idx")
  @@index([deliveryZoneId], map: "Order_deliveryZoneId_idx")
  @@map("order")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  variantId      String
  orderId        BigInt?
  actorUserId    String?
  type           InventoryMovementType
  quantityChange Int
  reason         String?               @db.VarChar(300)
  idempotencyKey String                @unique(map: "InventoryMovement_idempotencyKey_key") @db.VarChar(191)
  createdAt      DateTime              @default(now())
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict, map: "InventoryMovement_variantId_fkey")
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull, map: "InventoryMovement_orderId_fkey")
  actor          User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull, map: "InventoryMovement_actorUserId_fkey")

  @@index([variantId, createdAt], map: "InventoryMovement_variantId_createdAt_idx")
  @@index([orderId], map: "InventoryMovement_orderId_idx")
  @@index([actorUserId], map: "InventoryMovement_actorUserId_idx")
  @@map("inventorymovement")
}

model OrderAddress {
  id            String   @id @default(cuid())
  orderId       BigInt   @unique(map: "OrderAddress_orderId_key")
  recipientName String   @db.VarChar(160)
  phone         String   @db.VarChar(40)
  street        String   @db.VarChar(200)
  streetExtra   String?  @db.VarChar(200)
  postalCode    String   @db.VarChar(16)
  city          String   @db.VarChar(120)
  countryCode   String   @default("CH") @db.Char(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderAddress_orderId_fkey")

  @@map("orderaddress")
}

model OrderItem {
  id                    String            @id @default(cuid())
  orderId               BigInt
  productId             String?
  variantId             String?
  productNameDeSnapshot String            @db.VarChar(180)
  productNameEnSnapshot String            @db.VarChar(180)
  variantNameDeSnapshot String?           @db.VarChar(160)
  variantNameEnSnapshot String?           @db.VarChar(160)
  unitPriceRappen       Int
  quantity              Int
  lineSubtotalRappen    Int
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  product               Product?          @relation(fields: [productId], references: [id], onDelete: SetNull, map: "OrderItem_productId_fkey")
  variant               ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull, map: "OrderItem_variantId_fkey")
  options               OrderItemOption[]

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
  @@index([variantId], map: "OrderItem_variantId_idx")
  @@map("orderitem")
}

model OrderItemOption {
  id               String    @id @default(cuid())
  orderItemId      String
  nameDeSnapshot   String    @db.VarChar(160)
  nameEnSnapshot   String    @db.VarChar(160)
  priceDeltaRappen Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, map: "OrderItemOption_orderItemId_fkey")

  @@index([orderItemId], map: "OrderItemOption_orderItemId_idx")
  @@map("orderitemoption")
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     BigInt
  actorUserId String?
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?      @db.VarChar(300)
  note        String?      @db.Text
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderStatusEvent_orderId_fkey")
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull, map: "OrderStatusEvent_actorUserId_fkey")

  @@index([orderId, createdAt], map: "OrderStatusEvent_orderId_createdAt_idx")
  @@index([actorUserId], map: "OrderStatusEvent_actorUserId_idx")
  @@map("orderstatusevent")
}

model Payment {
  id                      String          @id @default(cuid())
  orderId                 BigInt          @unique(map: "Payment_orderId_key")
  provider                PaymentProvider
  status                  PaymentStatus   @default(PENDING)
  stripeCheckoutSessionId String?         @unique(map: "Payment_stripeCheckoutSessionId_key") @db.VarChar(255)
  stripePaymentIntentId   String?         @unique(map: "Payment_stripePaymentIntentId_key") @db.VarChar(255)
  amountRappen            Int
  refundedRappen          Int             @default(0)
  paidAt                  DateTime?
  failedAt                DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "Payment_orderId_fkey")
  refunds                 Refund[]

  @@index([status, createdAt], map: "Payment_status_createdAt_idx")
  @@map("payment")
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  requestedByUserId String?
  stripeRefundId    String       @unique(map: "Refund_stripeRefundId_key") @db.VarChar(255)
  amountRappen      Int
  reason            String       @db.VarChar(500)
  status            RefundStatus @default(PENDING)
  failureMessage    String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "Refund_paymentId_fkey")
  requestedBy       User?        @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull, map: "Refund_requestedByUserId_fkey")

  @@index([paymentId, createdAt], map: "Refund_paymentId_createdAt_idx")
  @@index([requestedByUserId], map: "Refund_requestedByUserId_idx")
  @@index([status, createdAt], map: "Refund_status_createdAt_idx")
  @@map("refund")
}

model StripeWebhookEvent {
  id          String                  @id @default(cuid())
  eventId     String                  @unique(map: "StripeWebhookEvent_eventId_key") @db.VarChar(255)
  type        String                  @db.VarChar(160)
  status      WebhookProcessingStatus @default(PROCESSING)
  error       String?                 @db.Text
  processedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status, createdAt], map: "StripeWebhookEvent_status_createdAt_idx")
  @@map("stripewebhookevent")
}

model NotificationDelivery {
  id               String              @id @default(cuid())
  orderId          BigInt?
  channel          NotificationChannel
  kind             String              @db.VarChar(120)
  recipient        String              @db.VarChar(512)
  deduplicationKey String              @unique(map: "NotificationDelivery_deduplicationKey_key") @db.VarChar(255)
  status           NotificationStatus  @default(PENDING)
  attemptCount     Int                 @default(0)
  providerId       String?             @db.VarChar(255)
  lastError        String?             @db.Text
  sentAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "NotificationDelivery_orderId_fkey")

  @@index([orderId, createdAt], map: "NotificationDelivery_orderId_createdAt_idx")
  @@index([status, createdAt], map: "NotificationDelivery_status_createdAt_idx")
  @@map("notificationdelivery")
}

model AuditLog {
  id                   String   @id @default(cuid())
  actorUserId          String?
  action               String   @db.VarChar(160)
  entityType           String   @db.VarChar(120)
  entityId             String   @db.VarChar(255)
  metadata             Json?
  requestCorrelationId String?  @db.VarChar(120)
  createdAt            DateTime @default(now())
  actor                User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, map: "AuditLog_actorUserId_fkey")

  @@index([actorUserId, createdAt], map: "AuditLog_actorUserId_createdAt_idx")
  @@index([entityType, entityId, createdAt], map: "AuditLog_entityType_entityId_createdAt_idx")
  @@index([requestCorrelationId], map: "AuditLog_requestCorrelationId_idx")
  @@map("auditlog")
}

model PublicRequestRateLimit {
  key             String   @id @db.VarChar(80)
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt], map: "PublicRequestRateLimit_expiresAt_idx")
  @@map("publicrequestratelimit")
}
