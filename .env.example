# Local development database only. Production uses a dedicated managed database
# URL ending in ?sslaccept=strict, runtime TLS, and a provider-approved pool limit.
DATABASE_URL="mysql://zambiel:change-me@127.0.0.1:3306/zambiel_dev"
DATABASE_CONNECTION_LIMIT="5"
DATABASE_SSL="false"
# Optional base64-encoded provider CA bundle when it is not in the system trust store.
# DATABASE_SSL_CA_BASE64=""

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="placeholder-google-secret"

# Initial owner bootstrap (used only by prisma db seed; do not add these to Vercel).
OWNER_EMAIL="owner@example.invalid"
OWNER_PASSWORD="replace-with-a-strong-password"
OWNER_NAME="Zambiel Owner"

# AWS S3 placeholders. Use a bucket-scoped IAM principal in hosted environments.
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="placeholder-access-key"
AWS_SECRET_ACCESS_KEY="placeholder-secret-key"
S3_BUCKET_NAME="zambiel-placeholder"
S3_PUBLIC_BASE_URL="https://zambiel-placeholder.s3.eu-central-1.amazonaws.com"

# Resend placeholders
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="Zambiel <no-reply@example.invalid>"

# Public app URL
APP_URL="http://localhost:3000"
# Public S3 URL for the signed Android APK. Configure the object with Content-Disposition: attachment.
# STAFF_APK_URL="https://assets.example.invalid/apps/zambiel-staff.apk"

# Stripe test mode locally; production preflight requires sk_live_.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
